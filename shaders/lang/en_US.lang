screen.XON_LIGHT=Light & Atmosphere
screen.XON_SKY=Sky & Clarity
screen.XON_WATER=Water
screen.XON_CAMERA=Camera
screen.XON_PERFORMANCE=Performance
option.XON_MOTION_BLUR=Smooth Camera Motion
option.XON_MOTION_BLUR.comment=Subtle camera blur with adjustable exposure and capped radius. Enabled by default. Hand and HUD remain sharp. No object motion vectors.
option.XON_BLUR_STRENGTH=Motion Blur Smoothness
option.XON_BLUR_STRENGTH.comment=Adjusts camera motion blur strength and smoothness. Default 1.00.
option.XON_SATURATION=Color Saturation
option.XON_SATURATION.comment=Controls overall color saturation. Default 70% balances vibrant colors without oversaturation; 100%+ boosts saturation further.
value.XON_SATURATION.0.00=0% (Grayscale)
value.XON_SATURATION.0.25=25% (Muted)
value.XON_SATURATION.0.50=50% (Soft)
value.XON_SATURATION.0.60=60% (Natural)
value.XON_SATURATION.0.70=70% (Default)
value.XON_SATURATION.0.80=80% (Rich)
value.XON_SATURATION.0.90=90% (Vivid)
value.XON_SATURATION.1.00=100% (Full)
value.XON_SATURATION.1.20=120% (Extra Vivid)
value.XON_SATURATION.1.40=140% (Max Boost)
option.XON_HAND_LIGHT=Held Light
option.XON_HAND_LIGHT.comment=Warm local light from luminous items held in either hand.
option.XON_CLOUD_LIGHTING=Cloud Lighting
option.XON_CLOUD_LIGHTING.comment=Warm daytime clouds and cool storm undersides. Uses vanilla cloud geometry and respects your cloud setting.
option.XON_BRIGHTNESS=Brightness
option.XON_BRIGHTNESS.comment=Overall brightness with a highlight-preserving output curve. Default 1.05.
option.XON_WARMTH=Sunlight Warmth
option.XON_WARMTH.comment=Warm direct sunlight while keeping the sky fill cool and blocks recognizable.
option.XON_WATER_DETAIL=Organic Water Waves
option.XON_WATER_DETAIL.comment=Non-repeating organic multi-layered water ripples with distance fading. No parallax or reflection ray marching.
value.XON_WATER_DETAIL.0=Off
value.XON_WATER_DETAIL.1=On
option.XON_FOG_AMOUNT=Atmosphere Density
option.XON_FOG_AMOUNT.comment=Controls optional atmospheric fog and underwater absorption. Air fog is OFF by default for a clear world.
option.XON_RENDER_MODE=Render Mode
option.XON_RENDER_MODE.comment=Native is the default. Experimental Boost reduces world pixel shading and reconstructs the image; it can improve GPU-limited performance at a sharpness cost. It does not accelerate chunks or simulation. Compare FPS yourself.
value.XON_RENDER_MODE.0=Native - Full Resolution
value.XON_RENDER_MODE.1=Boost Quality - Experimental 85%
value.XON_RENDER_MODE.2=Boost Performance - Experimental 75%
profile.SPEED=Speed
profile.BALANCED=Balanced - Default
option.XON_SHADOWS=Sun & Moon Shadows
option.XON_SHADOWS.comment=Real directional cast shadows with four hardware-filtered samples. Most significant extra world-rendering cost. Disable for maximum speed.
option.shadowMapResolution=Shadow Resolution
option.shadowMapResolution.comment=1024 is the performance default. Higher values improve fine shadow detail at a GPU and memory cost.
option.shadowDistance=Shadow Distance
option.shadowDistance.comment=Cast shadows fade into skylight shading near this distance. Default 64 blocks for higher FPS and sharper nearby shadows.
option.XON_LIGHT_SHAFTS=Localized Sun Rays
option.XON_LIGHT_SHAFTS.comment=Fast bounded shadow-map samples at half resolution, confined near the sun. Requires shadows. Does not add global distance haze.
option.XON_EMISSIVE_ORES=Glowing Ore Veins
option.XON_EMISSIVE_ORES.comment=Selective colored ore flecks glow while gray host rock stays dark. Surface emission; does not propagate colored light to neighboring blocks.
option.XON_ORE_GLOW=Ore Glow Strength
option.XON_ORE_GLOW.comment=Emission strength for colored veins. Bloom adds a small local halo.
option.XON_BLOOM=Restrained Light Bloom
option.XON_BLOOM.comment=Small half-resolution glow around bright lamps and ore flecks. Thresholded to keep the rest of the image clear.
option.XON_REFRACTION=Clear Water Refraction
option.XON_REFRACTION.comment=Depth absorption and wave distortion using a half-resolution opaque scene copy. Disable to remove the copy pass.
option.XON_COLOR_GRADE=XON Color Grade
option.XON_COLOR_GRADE.comment=Original 16-cube LUT with modest vibrance, warm sunlight and restrained cool shade. Uses two filtered texture reads.
option.XON_GRADE_STRENGTH=Color Grade Strength
option.XON_GRADE_STRENGTH.comment=Blends the authored LUT with the neutral tone-mapped image. Default 0.85.
option.XON_CLOUD_STYLE=Cloud Style
option.XON_CLOUD_STYLE.comment=Soft layered clouds replace vanilla clouds by default. Vanilla mode restores the game cloud setting.
value.XON_CLOUD_STYLE.0=Vanilla Clouds
value.XON_CLOUD_STYLE.1=Soft Layered Clouds
option.XON_EDGE_AA=Sharp Edge AA
option.XON_EDGE_AA.comment=Lightweight spatial AA in the final pass. Depth curvature limits smoothing to geometry edges, preserving flat-surface texture detail. No temporal history.
option.XON_BLOCK_OUTLINE=Block Selection Outline
option.XON_BLOCK_OUTLINE.comment=Choose between a clean Black block selection outline or a smooth animated Rainbow outline when looking at a block.
value.XON_BLOCK_OUTLINE.0=Black Outline
value.XON_BLOCK_OUTLINE.1=Rainbow Outline
option.XON_AIR_FOG=Air Fog
option.XON_AIR_FOG.comment=OFF by default for crystal-clear air. Enable only if you want distance haze and a fogged horizon. Underwater and status-effect fog remain.
option.XON_AO_STRENGTH=Ambient Occlusion Depth
option.XON_AO_STRENGTH.comment=Controls deep corner and pocket shading on blocks while keeping foliage and sunlit tops clean. Default 1.00.
option.XON_WAVING_FOLIAGE=Waving Plants & Leaves
option.XON_WAVING_FOLIAGE.comment=Gentle vertex-stage wind motion on leaves, grass, wheat, crops, and vines with anchored roots. Zero fragment cost.
option.XON_CAUSTICS=Underwater Light Caustics
option.XON_CAUSTICS.comment=Animated sunlight caustic patterns on underwater terrain and submerged blocks.
