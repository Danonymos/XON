screen.XON_PERFORMANCE=Performance & Quick Toggles
profile.SPEED=Speed (Max FPS)
profile.BALANCED=Balanced (Default)
profile.VIBRANT=Vibrant Fantasy
profile.CINEMATIC=Cinematic Ultra
option.XON_MOTION_BLUR=Smooth Camera Motion
option.XON_MOTION_BLUR.comment=Adds subtle cinematic blur when turning the camera while keeping your hand, held items, and HUD razor-sharp. Default: ON.
option.XON_BLUR_STRENGTH=Motion Blur Smoothness
option.XON_BLUR_STRENGTH.comment=Controls how strong and smooth the camera motion blur looks when turning. Default: 1.50 (150%). Smooth Camera Motion is ON by default.
option.XON_SATURATION=Color Saturation
option.XON_SATURATION.comment=Controls overall color richness across the world. Default 70% balances natural vanilla colors with vibrant lighting; 80-140% gives a lush fantasy palette.
value.XON_SATURATION.0.00=0% (Grayscale)
value.XON_SATURATION.0.25=25% (Muted)
